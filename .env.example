# Muse Spark through the Meta Model API. Not required with --mock.
# Put the key on this line. Do not commit this file once it has a real key.
MODEL_API_KEY=

# Optional. Defaults to muse-spark-1.3.
MUSE_MODEL=muse-spark-1.3
ANALYSIS_PROVIDER=muse

